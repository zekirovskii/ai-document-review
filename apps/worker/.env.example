NODE_ENV=development
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_MS=2000
# Mark a job as FAILED if its worker has not completed it within this time.
WORKER_STALE_PROCESSING_MS=300000

# Server-only Supabase configuration. Do not expose this value to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
