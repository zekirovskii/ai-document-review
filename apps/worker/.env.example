NODE_ENV=development
LOG_LEVEL=info
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_MS=2000
# Mark a job as FAILED if its worker has not completed it within this time.
WORKER_STALE_PROCESSING_MS=300000
# Retry transient infrastructure failures only. Attempts include the current claim.
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=5000
WORKER_RETRY_MAX_DELAY_MS=60000
# Periodic safe lifecycle log; this does not add an HTTP listener.
WORKER_HEARTBEAT_INTERVAL_MS=60000

# Analysis defaults to local deterministic rules. Gemini mode sends extracted PDF text to Google.
ANALYSIS_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_INPUT_CHARS=120000

# Server-only Supabase configuration. Do not expose these values to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
