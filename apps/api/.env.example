NODE_ENV=development
# Railway injects PORT automatically. API_PORT is the local-development fallback.
API_PORT=3001
MAX_PDF_SIZE_BYTES=10485760
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Server-only Supabase configuration. Do not expose these values to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
